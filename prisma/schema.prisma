
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads     Lead[]
  templates EmailTemplate[]
  outreach  Outreach[]

  @@map("users")
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  company     String
  title       String?
  phone       String?
  industry    String?
  companySize String?
  source      String?
  status      String   @default("New")
  score       Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreach  Outreach[]

  @@map("leads")
}

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  category    String   @default("cold_outreach")
  isActive    Boolean  @default(true)
  sentCount   Int      @default(0)
  openCount   Int      @default(0)
  replyCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreach Outreach[]

  @@map("email_templates")
}

model Outreach {
  id          String   @id @default(cuid())
  subject     String
  body        String
  sentAt      DateTime?
  openedAt    DateTime?
  repliedAt   DateTime?
  status      String   @default("draft")
  scheduledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadId     String
  lead       Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  templateId String?
  template   EmailTemplate? @relation(fields: [templateId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("outreach")
}

model LeadScore {
  id       String @id @default(cuid())
  criteria String
  weight   Int
  isActive Boolean @default(true)

  @@map("lead_scores")
}
